<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuietInbox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.QuietInbox.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/quiet_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/quiet_teal</item>
        <item name="postSplashScreenTheme">@style/Theme.QuietInbox</item>
    </style>
</resources>

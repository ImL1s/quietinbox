    <!-- Onboarding -->
    <string name="ob_step_of">Step %1$d of %2$d</string>
    <string name="ob_scope_title">Copies of your notifications, kept on this device</string>
    <string name="ob_scope_body">QuietInbox saves what messaging apps post to the notification shade so you can read it later without opening the chat.</string>
    <string name="ob_scope_point_1">Nothing leaves this phone: no internet permission, no analytics.</string>
    <string name="ob_scope_point_2">Reading a copy never marks the source as read and never replies.</string>
    <string name="ob_scope_point_3">Only what the source app puts in a notification can be captured; gaps are shown, not hidden.</string>
    <string name="ob_scope_point_4">Everything is stored in an encrypted vault with a key unique to this installation.</string>
    <string name="ob_sources_title">Choose sources</string>
    <string name="ob_sources_body">Pick the apps whose notifications you want to keep. You can change this any time in Capture.</string>
    <string name="ob_sources_not_installed">Not installed</string>
    <string name="ob_access_title">Allow notification access</string>
    <string name="ob_access_body">Android asks you to confirm in system settings. QuietInbox uses the standard listener API and never bypasses restricted settings.</string>

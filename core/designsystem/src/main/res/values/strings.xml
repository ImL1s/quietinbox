    <string name="section_privacy">Privacy &amp; security</string>
    <string name="ui_lock">Lock the app</string>
    <string name="ui_lock_desc">Require your screen lock or biometrics to open QuietInbox. Capture keeps running in the background; this is a UI gate, not a second encryption layer.</string>
    <string name="screenshot_protection">Block screenshots</string>
    <string name="screenshot_protection_desc">Hide content in Recents and prevent screenshots on most devices.</string>
    <string name="section_retention">Retention</string>
    <string name="retention_days">Keep copies for %1$d days</string>
    <string name="retention_desc">Expired copies, their edits, index entries and media are removed by a background task. Deleting a single item does not physically wipe flash storage.</string>
    <string name="journal_ttl">Event journal kept for %1$d hours</string>
    <string name="section_media">Media</string>
    <string name="media_copy">Copy images from notifications</string>
    <string name="media_copy_desc">Only readable content URIs and bitmaps the notification already contains. Nothing is downloaded.</string>
    <string name="media_disclosure_title">About media copies</string>
    <string name="media_disclosure_body">QuietInbox has no internet permission, but a source app\'s content provider may fetch data itself when a URI is read. Copies are encrypted and capped in size.</string>
    <string name="section_reminders">Your own reminders</string>
    <string name="reminders_enable">Daily reminder</string>
    <string name="reminders_desc">Off by default. A local reminder to review your inbox; it never affects capture and respects Do Not Disturb.</string>

    <string name="backup_recovery_key">Recovery key</string>
    <string name="backup_recovery_key_desc">The only way to open your backups on another device. Write it down and keep it offline.</string>
    <string name="backup_show_key">Show recovery key</string>
    <string name="backup_key_warning">Anyone with this key and a backup file can read your copies. QuietInbox cannot recover it for you.</string>
    <string name="backup_key_ack">I have saved my recovery key</string>
    <string name="backup_export">Export encrypted backup</string>
    <string name="backup_export_desc">Streams an encrypted file to a location you choose. If you pick a cloud folder, the ciphertext leaves this device.</string>
    <string name="backup_import">Restore from backup</string>
    <string name="backup_import_desc">Merges a backup into this vault after verifying every block. This can bring back content you deleted earlier. Restored sources come back disabled; re-enable them in Capture.</string>

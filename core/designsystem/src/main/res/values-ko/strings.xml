    <!-- Onboarding -->
    <string name="ob_step_of">%2$d단계 중 %1$d단계</string>
    <string name="ob_scope_title">알림 사본을 이 기기에 보관</string>
    <string name="ob_scope_body">QuietInbox는 메시징 앱이 알림 창에 게시한 내용을 저장하므로, 채팅을 열지 않고도 나중에 읽을 수 있습니다.</string>
    <string name="ob_scope_point_1">아무것도 이 휴대전화를 떠나지 않습니다. 인터넷 권한도 분석도 없습니다.</string>
    <string name="ob_scope_point_2">사본을 읽어도 원본에 읽음 표시가 되지 않고 답장도 하지 않습니다.</string>
    <string name="ob_scope_point_3">원본 앱이 알림에 담은 내용만 캡처할 수 있습니다. 누락은 숨기지 않고 표시합니다.</string>
    <string name="ob_scope_point_4">모든 내용은 이 설치에 고유한 키로 암호화된 보관소에 저장됩니다.</string>
    <string name="ob_sources_title">소스 선택</string>
    <string name="ob_sources_body">알림을 보관할 앱을 고르세요. ‘캡처’에서 언제든지 바꿀 수 있습니다.</string>
    <string name="ob_sources_not_installed">설치되지 않음</string>
    <string name="ob_access_title">알림 액세스 허용</string>
    <string name="ob_access_body">Android가 시스템 설정에서 확인을 요청합니다. QuietInbox는 표준 리스너 API를 사용하며 제한된 설정을 우회하지 않습니다.</string>
    <string name="ob_access_granted">액세스 허용됨</string>
    <string name="ob_access_button">시스템 설정 열기</string>
    <string name="ob_test_title">테스트 알림 보내기</string>
    <string name="ob_test_body">QuietInbox 자체의 합성 대화로 캡처, 파싱, 중복 제거, 암호화 저장까지 전체 파이프라인을 보여 줍니다.</string>
    <string name="ob_test_button">테스트 알림 보내기</string>
    <string name="ob_test_waiting">사본을 기다리는 중…</string>
    <string name="ob_test_captured">메시지 %1$d개를 캡처하여 저장했습니다.</string>
    <string name="ob_preview_title">보게 될 내용</string>
    <string name="ob_preview_body">각 사본에는 출처, 캡처 시각, 그리고 가능한 경우 출처 시각이 표시됩니다. 발신자가 불확실하거나, 미리보기가 숨겨졌거나, 메시지가 중복일 수 있을 때는 라벨로 알려 줍니다.</string>
    <string name="ob_next">다음</string>
    <string name="ob_back">뒤로</string>
    <string name="ob_finish">시작</string>
    <string name="ob_skip">건너뛰기</string>
    <string name="ob_notification_permission">테스트를 보내려면 QuietInbox의 알림 게시를 허용하세요.</string>

